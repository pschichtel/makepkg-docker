ARG BASE_IMAGE

FROM $BASE_IMAGE

RUN yay -S --noconfirm --answerdiff None --answerclean None claude-code \
 && rm -Rf ~/.cache/yay /packages/*

RUN sudo pacman -Sy --noconfirm docker podman chromium rust nodejs npm htop bash-completion \
 && sudo pacman -Sccc --noconfirm

RUN sudo pacman -Sy --noconfirm opencode \
 && sudo pacman -Sccc --noconfirm

RUN sudo pacman -Sy --noconfirm qwen-code \
 && sudo pacman -Sccc --noconfirm

RUN sudo systemctl enable containerd docker \
 && sudo systemctl mask systemd-firstboot.service \
 && sudo systemctl mask systemd-networkd-wait-online.service \
 && sudo gpasswd -a builder docker

RUN sudo npm install -g @browsermcp/mcp@latest \
 && sudo rm -Rf /root/.npm /tmp/node-compile-cache

